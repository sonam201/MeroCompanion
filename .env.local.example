# Neon (https://console.neon.tech -> your project -> Connection Details)
DATABASE_URL=

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (https://resend.com/api-keys) - used for the signup email
# verification link and for reminder emails
AUTH_RESEND_KEY=
RESEND_FROM_EMAIL=
