# Neon (https://console.neon.tech -> your project -> Connection Details)
DATABASE_URL=

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=

# Gmail SMTP (used for the signup email verification code and for reminder
# emails) - GMAIL_USER is the sending Gmail address; GMAIL_APP_PASSWORD is a
# 16-character App Password generated at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on that Google account first).
# Never put the real App Password in this example file - only in .env.local.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret for the scheduled missed-task-reminder cron route
# (src/app/api/cron/missed-task-reminders). There's no signed-in user for this
# caller, so this secret is what authenticates the GitHub Actions workflow
# instead. Generate with: openssl rand -hex 32
CRON_SECRET=
